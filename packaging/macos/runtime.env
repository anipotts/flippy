# The self-contained Flippy.app's pinned runtime (scripts/build_app.sh sources this).
# Changing anything here, requirements-mac.txt or Launcher.swift changes the runtime fingerprint
# (flippy/bundle.py): installed apps then ask for the new Flippy.dmg instead of updating their code.
PY_RELEASE=20260924
PY_VERSION=3.13.15
PIXMAN=0.46.2
LIBPNG=1.6.58
CAIRO=1.18.4
PYCAIRO=1.29.2
MACOSX_DEPLOYMENT_TARGET=13.0
